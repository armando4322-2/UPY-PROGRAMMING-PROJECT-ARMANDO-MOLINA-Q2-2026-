# Copia este archivo como .env y rellena tus credenciales.
# El archivo .env esta en .gitignore y NUNCA debe subirse al repositorio.
#
# Como obtenerlas:
#   1. Entra a https://developer.spotify.com/dashboard con tu cuenta de Spotify
#   2. Create app  ->  nombre: Folk Analytics
#      Redirect URI: http://localhost:8888/callback
#   3. Copia el Client ID y el Client Secret aqui abajo

SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
